---
import { negative, optional, set } from "astro:schema";
import Layout from "../layouts/Layout.astro";

const base = Astro.url.origin;
const productosRes = await fetch(`${base}/api/productos`)

if (!productosRes.ok) {
	throw new Error("error en prodcutos");
}
const productos = await productosRes.json()


const categorias = [...new Set(productos.map(item => item.categoria))]

console.log(categorias)


---

<Layout>

    
    <div class="min-h-screen bg-gray-100 p-4">
      <a
     href="/registros"
     class="flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2 text-white shadow active:scale-95"
      >
    Inicio

   </a>

    <div id="contentListaMermas" class="bg-white rounded-xl shadow-md p-4 border border-gray-200 mb-3 mt-3  ">
      <h1 class="mb-4 text-2xl font-bold text-gray-800">
        Mermas
      </h1>

      <div id="listaMermas" class="space-y-3 hidden"></div>
    </div>

<div id="contentCreateProdcucto" class="bg-white rounded-xl shadow-md p-4 border border-gray-200">

  <h1 class="mb-4 text-2xl font-bold text-gray-800">
    Crear Producto
  </h1>

  <div id="crearProductos" class="space-y-3">

    <form id="formCrearProducto" class="mt-4 space-y-5">

      <!-- Categoría -->
      <div class="space-y-2">
        <label
          for="categoria"
          class="block text-sm font-semibold text-gray-700"
        >
          Categoría
        </label>

        <select
          name="categoria"
          id="categoria"
          class="w-full rounded-lg border border-gray-300 bg-white p-3 text-gray-700"
        >
          {
            categorias.map((element) => (
              <option value={element}>
                {element}
              </option>
            ))
          }

          <option value="nueva">
            + Nueva categoría
          </option>
        </select>
      </div>

      <!-- Nueva categoría -->
      <div
        id="inputNuevaCategoria"
        class="hidden space-y-2"
      >
        <label
          for="nuevaCategoria"
          class="block text-sm font-semibold text-gray-700"
        >
          Nombre de la nueva categoría
        </label>

        <input
          id="nuevaCategoria"
          name="nuevaCategoria"
          type="text"
          placeholder="Ej: Bebidas"
          class="w-full rounded-lg border border-gray-300 p-3"
        />
      </div>

      <!-- Producto -->
      <div class="space-y-2">
        <label
          for="nombreProducto"
          class="block text-sm font-semibold text-gray-700"
        >
          Nombre del producto
        </label>

        <input
          id="nombreProducto"
          name="nombre"
          type="text"
          placeholder="Ej: Coca Cola"
          class="w-full rounded-lg border border-gray-300 p-3"
        />
      </div>

      <button
        type="submit"
        class="w-full rounded-lg bg-blue-600 px-4 py-3 font-semibold text-white"
      >
        Crear producto
      </button>

    </form>

  </div>

</div>

    
  </div>
</Layout>

<script>
  const contentMermas = document.getElementById(
    "contentListaMermas"
  ) as HTMLDivElement;

  const newProdcucto = document.getElementById(
    "contentCreateProdcucto"
  ) as HTMLDivElement;

  const listaMerma = document.getElementById(
    "listaMermas"
  ) as HTMLDivElement;

  const Productonew = document.getElementById(
    "crearProductos"
  ) as HTMLDivElement;


  // =========================
  // MOSTRAR / OCULTAR MERMAS
  // =========================

  contentMermas.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;

    const card = target.closest(".card-merma");

    if (card) {
      return;
    }

    const result = listaMerma.classList.toggle("hidden");

    listaMerma.classList.toggle("active", result);
  });


  // =========================
  // CATEGORÍA
  // =========================

  const categoriaSelect = document.getElementById(
    "categoria"
  ) as HTMLSelectElement;

  const inputNuevaCategoria = document.getElementById(
    "inputNuevaCategoria"
  ) as HTMLDivElement;

  const nuevaCategoria = document.getElementById(
    "nuevaCategoria"
  ) as HTMLInputElement;


  // Mostrar / ocultar input de nueva categoría

  categoriaSelect.addEventListener("change", () => {
    inputNuevaCategoria.classList.toggle(
      "hidden",
      categoriaSelect.value !== "nueva"
    );
  });


  // =========================
  // CREAR PRODUCTO
  // =========================

  const formCrearProducto = document.getElementById(
    "formCrearProducto"
  ) as HTMLFormElement;

  const nombreProducto = document.getElementById(
    "nombreProducto"
  ) as HTMLInputElement;


  formCrearProducto.addEventListener("submit", async (e) => {
    e.preventDefault();

    // Obtener nombre
    const nombre = nombreProducto.value.trim();

    // Obtener categoría
    let categoria = categoriaSelect.value;

    // Si seleccionó "nueva",
    // usamos lo escrito en el input
    if (categoria === "nueva") {
      categoria = nuevaCategoria.value.trim();
    }


    // Validar
    if (!nombre) {
      alert("Ingrese el nombre del producto");
      return;
    }

    if (!categoria) {
      alert("Seleccione o ingrese una categoría");
      return;
    }


    try {
      const response = await fetch("/api/productos", {
        method: "POST",

        headers: {
          "Content-Type": "application/json",
        },

        body: JSON.stringify({
          nombre,
          categoria,
        }),
      });


      const data = await response.json();


      if (!response.ok) {
        alert(data.error || "Error al crear el producto");
        return;
      }


      alert("Producto creado correctamente");


      // Limpiar formulario

      formCrearProducto.reset();

      // Ocultar input de nueva categoría

      inputNuevaCategoria.classList.add("hidden");


    } catch (error) {
      console.error(error);

      alert("Error de conexión con el servidor");
    }
  });


  // =========================
  // CARGAR MERMAS
  // =========================

  async function cargarMermas() {
    const response = await fetch("/api/mermas");

    const mermas = await response.json();

    const lista = document.getElementById(
      "listaMermas"
    ) as HTMLDivElement;

    lista.innerHTML = "";

    mermas.forEach((item) => {
      const card = document.createElement("div");

      card.className =
        "card-merma rounded-xl bg-white p-4 shadow border border-gray-200";

      card.innerHTML = `
        <div class="mb-3">
          <h2 class="text-lg font-semibold text-gray-800">
            ${item.productos.nombre}
          </h2>
        </div>

        <div class="flex items-center gap-3">

          <input
            id="merma-${item.id}"
            type="number"
            value="${item.merma}"
            class="flex-1 rounded-lg border border-gray-300 p-2 text-center text-lg"
          />

          <button
            class="rounded-lg bg-green-600 px-4 py-2 font-medium text-white active:scale-95"
            data-id="${item.id}"
          >
            Guardar
          </button>

        </div>
      `;


      const boton = card.querySelector("button") as HTMLButtonElement;

      boton.addEventListener("click", async () => {

        const input = document.getElementById(
          `merma-${item.id}`
        ) as HTMLInputElement;

        const nuevaMerma = Number(input.value);

        await actualizarMerma(item.id, nuevaMerma);
      });


      lista.appendChild(card);
    });
  }


  // =========================
  // ACTUALIZAR MERMA
  // =========================

  async function actualizarMerma(
    id: number,
    nuevaMerma: number
  ) {

    const response = await fetch("/api/mermas", {
      method: "PATCH",

      headers: {
        "Content-Type": "application/json",
      },

      body: JSON.stringify({
        id,
        merma: nuevaMerma,
      }),
    });


    if (response.ok) {
      alert("Merma actualizada");
    }
  }


  // =========================
  // MOSTRAR / OCULTAR
  // FORMULARIO PRODUCTO
  // =========================

  function toggleCrearProdcuto() {

    newProdcucto?.addEventListener("click", (e) => {

      const target = e.target as HTMLElement;

      const cardProdcut = target.closest("#crearProductos");

      if (cardProdcut) {
        return;
      }

      const result = Productonew.classList.toggle("hidden");

      Productonew.classList.toggle("active", result);
    });
  }


  toggleCrearProdcuto();


  // =========================
  // INICIAR
  // =========================

  cargarMermas();
</script>