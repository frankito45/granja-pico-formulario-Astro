---
export const prerender = false;


import { map, optional } from "astro:schema";
import Layout from "../layouts/Layout.astro";


const base = Astro.url.origin;
const productosRes = await fetch(`${base}/api/productos`)

if (!productosRes.ok) {
	throw new Error("error en prodcutos");
}
const productos = await productosRes.json()


const categorias = [...new Set(productos.map(item => item.categoria))]

console.log(categorias)


---

<Layout>

    
    <div class="min-h-screen bg-gray-100 p-4">
      <a
     href="/registros"
     class="flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2 text-white shadow active:scale-95"
      >
    Inicio

   </a>

    <div id="contentListaMermas" class="bg-white rounded-xl shadow-md p-4 border border-gray-200 mb-3 mt-3  ">
      <h1 class="mb-4 text-2xl font-bold text-gray-800">
        Mermas
      </h1>

      <div id="listaMermas" class="space-y-3 hidden"></div>
    </div>

<div id="contentCreateProducto" class="bg-white rounded-xl shadow-md p-4 border border-gray-200">

  <h1 class="mb-4 text-2xl font-bold text-gray-800">
    Crear Producto
  </h1>

  <div id="crearProductos" class="space-y-3">

    <form id="formCrearProducto" class="mt-4 space-y-5">

      <!-- Categoría -->
      <div class="space-y-2">
        <label
          for="categoria"
          class="block text-sm font-semibold text-gray-700"
        >
          Categoría
        </label>

        <select
          name="categoria"
          id="categoria"
          class="w-full rounded-lg border border-gray-300 bg-white p-3 text-gray-700"
        >
          {
            categorias.map((element) => (
              <option value={element}>
                {element}
              </option>
            ))
          }

          <option value="nueva">
            + Nueva categoría
          </option>
        </select>
      </div>

      <!-- Nueva categoría -->
      <div
        id="inputNuevaCategoria"
        class="hidden space-y-2"
      >
        <label
          for="nuevaCategoria"
          class="block text-sm font-semibold text-gray-700"
        >
          Nombre de la nueva categoría
        </label>

        <input
          id="nuevaCategoria"
          name="nuevaCategoria"
          type="text"
          placeholder="Ej: Bebidas"
          class="w-full rounded-lg border border-gray-300 p-3"
        />
      </div>

      <!-- Producto -->
      <div class="space-y-2">
        <label
          for="nombreProducto"
          class="block text-sm font-semibold text-gray-700"
        >
          Nombre del producto
        </label>

        <input
          id="nombreProducto"
          name="nombre"
          type="text"
          placeholder="Ej: Coca Cola"
          class="w-full rounded-lg border border-gray-300 p-3"
        />
      </div>

      <button
        type="submit"
        class="w-full rounded-lg bg-blue-600 px-4 py-3 font-semibold text-white"
      >
        Crear producto
      </button>

    </form>

  </div>

</div>




<div
  id="contentEliminarProducto"
  class="bg-white rounded-xl shadow-md p-4 border border-gray-200"
  data-productos={JSON.stringify(productos)}
>
  <h1 class="mb-4 text-2xl font-bold text-gray-800">
    Eliminar Producto
  </h1>

  <div class="space-y-4">

    <!-- Seleccionar categoría -->
    <div class="space-y-2">
      <label
        for="categoria-Eliminar"
        class="block text-sm font-semibold text-gray-700"
      >
        Seleccione una categoría
      </label>

      <select
        id="categoria-Eliminar"
        class="w-full rounded-lg border border-gray-300 bg-white p-3 text-gray-700"
      >
        <option value="">
          Seleccione una categoría
        </option>

        {
          categorias.map((element) => (
            <option value={element}>
              {element}
            </option>
          ))
        }
      </select>
    </div>

    <!-- Lista de productos -->
    <div
      id="listaProductos"
      class="space-y-3"
    >
    </div>

  </div>
</div>



    
  </div>
</Layout>

<script>
  const contentMermas = document.getElementById(
    "contentListaMermas"
  ) as HTMLDivElement;

  const newProdcucto = document.getElementById(
    "contentCreateProducto"
  ) as HTMLDivElement;

  const listaMerma = document.getElementById(
    "listaMermas"
  ) as HTMLDivElement;

  const Productonew = document.getElementById(
    "crearProductos"
  ) as HTMLDivElement;

  // =========================
  // MOSTRAR / OCULTAR MERMAS
  // =========================

  contentMermas.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;

    const card = target.closest(".card-merma");

    if (card) {
      return;
    }

    const result = listaMerma.classList.toggle("hidden");

    listaMerma.classList.toggle("active", result);
  });


 

  // =========================
  // CARGAR MERMAS
  // =========================

  async function cargarMermas() {
    const response = await fetch("/api/mermas");

    const mermas = await response.json();

    const lista = document.getElementById(
      "listaMermas"
    ) as HTMLDivElement;

    lista.innerHTML = "";

    mermas.forEach((item) => {
      const card = document.createElement("div");

      card.className =
        "card-merma rounded-xl bg-white p-4 shadow border border-gray-200";

      card.innerHTML = `
        <div class="mb-3">
          <h2 class="text-lg font-semibold text-gray-800">
            ${item.productos.nombre}
          </h2>
        </div>

        <div class="flex items-center gap-3">

          <input
            id="merma-${item.id}"
            type="number"
            value="${item.merma}"
            class="flex-1 rounded-lg border border-gray-300 p-2 text-center text-lg"
          />

          <button
            class="rounded-lg bg-green-600 px-4 py-2 font-medium text-white active:scale-95"
            data-id="${item.id}"
          >
            Guardar
          </button>

        </div>
      `;


      const boton = card.querySelector("button") as HTMLButtonElement;

      boton.addEventListener("click", async () => {

        const input = document.getElementById(
          `merma-${item.id}`
        ) as HTMLInputElement;

        const nuevaMerma = Number(input.value);

        await actualizarMerma(item.id, nuevaMerma);
      });


      lista.appendChild(card);
    });
  }


  // =========================
  // ACTUALIZAR MERMA
  // =========================

  async function actualizarMerma(
    id: number,
    nuevaMerma: number
  ) {

    const response = await fetch("/api/mermas", {
      method: "PATCH",

      headers: {
        "Content-Type": "application/json",
      },

      body: JSON.stringify({
        id,
        merma: nuevaMerma,
      }),
    });


    if (response.ok) {
      alert("Merma actualizada");
    }
  }



  cargarMermas();
</script>

<script src="../script/crearProductos"></script>


<script src="../script/eliminarProducto"></script>
