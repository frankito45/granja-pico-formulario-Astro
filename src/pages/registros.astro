---

import Registro from "../components/registro.astro";
import Layaout from "../layouts/Layout.astro";
export const prerender = false;

const base = Astro.url.origin;
const productosRes = await fetch(`${base}/api/productos`)

if (!productosRes.ok) {
	throw new Error("error en prodcutos");
}
const productos = await productosRes.json()


const categorias = [...new Set(productos.map(item => item.categoria))]

---

<Layaout>
    <Registro categorias={categorias}></Registro>
</Layaout>